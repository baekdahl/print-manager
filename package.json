{
	"name": "print-manager",
	"type": "module",
	"scripts": {
		"dev": "pnpm local:up && tsx watch src/local.ts",
		"local:up": "[ -f .env ] || cp .env.example .env; docker compose up -d --wait && pnpm db:migrate",
		"fake-vendor": "tsx watch fake-vendor/server.ts",
		"sync": "tsx src/sync-once.ts",
		"build": "esbuild src/lambda/*.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --out-extension:.js=.cjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "pnpm local:up && vitest run",
		"test:watch": "pnpm local:up && vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/aws-lambda": "^8.10.164",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.5",
		"esbuild": "^0.28.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@aws-sdk/client-sqs": "^3.1167.0",
		"@hono/aws-lambda": "^1.0.0",
		"@hono/node-server": "^2.1.6",
		"@hono/swagger-ui": "^0.6.2",
		"@hono/zod-openapi": "^1.6.3",
		"@hono/zod-validator": "^0.9.1",
		"dotenv": "^18.0.10",
		"drizzle-orm": "1.0.0-rc.5",
		"hono": "^4.13.16",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
