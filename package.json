{
	"name": "print-manager",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/local.ts",
		"build": "esbuild src/lambda/*.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --out-extension:.js=.cjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "1.0.0-rc.5",
		"esbuild": "^0.28.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@hono/aws-lambda": "^1.0.0",
		"@hono/node-server": "^2.1.6",
		"@hono/zod-validator": "^0.9.1",
		"dotenv": "^18.0.10",
		"drizzle-orm": "1.0.0-rc.5",
		"hono": "^4.13.16",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
