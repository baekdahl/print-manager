DATABASE_URL=postgres://postgres:postgres@localhost:5432/print_manager
VENDOR_URL=http://localhost:4000
SYNC_INTERVAL_MS=60000
PRINT_JOBS_QUEUE_URL=http://localhost:9324/000000000000/print-jobs
# Local only: send SQS calls to ElasticMQ. ElasticMQ accepts any credentials.
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
